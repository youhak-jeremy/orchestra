FROM nvidia/cuda:11.7.1-cudnn8-runtime-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev build-essential ca-certificates gzip && \
    rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir --upgrade "pip<24" && \
    python3 -m pip install --no-cache-dir \
      torch==1.13.1+cu117 torchvision==0.14.1+cu117 \
      --extra-index-url https://download.pytorch.org/whl/cu117
WORKDIR /workspace/orchestra
COPY requirements-r34.txt .
RUN python3 -m pip install --no-cache-dir -r requirements-r34.txt
COPY . .
CMD ["python3", "r3_4_jobs.py", "--list"]
